# Merge into your EXISTING Chinese schema custom patch (e.g. wanxiang.custom.yaml).
# Copy lua/shi_emoji/ into the user Rime lua directory first.
patch:
  "engine/processors/@before 0": lua_processor@*shi_emoji.processor
  "engine/filters/+":
    - lua_filter@*shi_emoji.filter
  # Infrequent preferences: edit these values, then redeploy and reload Rime.
  # skin: default | light | medium_light | medium | medium_dark | dark
  "shi_emoji/skin": default
  # gender: neutral | female | male; explicit gender words still take precedence.
  "shi_emoji/gender": neutral
  # adult: false (off) | true (on); controls the separate 重口联想 library.
  "shi_emoji/adult": false
  "switches/+":
    - name: shi_emoji
      states: [诗Emoji关, 诗Emoji开]
